{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nguyentan510/aos/extensions/schema/extension-manifest-v1.schema.json",
  "title": "AOS declarative extension manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "id",
    "version",
    "type",
    "owner",
    "namespace",
    "aos_compatibility",
    "dependencies",
    "capabilities",
    "data_ownership",
    "security",
    "failure_behavior"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "contract_version": {
      "const": "AOS-SPEC-006"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "type": {
      "enum": [
        "domain",
        "language",
        "framework",
        "provider",
        "tool",
        "integration"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)+$"
    },
    "aos_compatibility": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version_requirement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "version_requirement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/repositorySummaryCapability"
          },
          {
            "$ref": "#/$defs/rustCargoSummaryCapability"
          }
        ]
      }
    },
    "data_ownership": {
      "type": "string",
      "minLength": 1
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "secrets",
        "process"
      ],
      "properties": {
        "network": {
          "const": false
        },
        "secrets": {
          "const": false
        },
        "process": {
          "const": false
        }
      }
    },
    "failure_behavior": {
      "const": "fail_closed"
    }
  },
  "$defs": {
    "capabilityBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "host_operation",
        "operation_class",
        "resource_scopes",
        "idempotent",
        "retryable",
        "compensatable",
        "reconciliation_required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)+$"
        },
        "host_operation": {
          "type": "string"
        },
        "operation_class": {
          "const": "read_only"
        },
        "resource_scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1
        },
        "idempotent": {
          "type": "boolean"
        },
        "retryable": {
          "type": "boolean"
        },
        "compensatable": {
          "const": false
        },
        "reconciliation_required": {
          "type": "boolean"
        }
      }
    },
    "repositorySummaryCapability": {
      "allOf": [
        {
          "$ref": "#/$defs/capabilityBase"
        },
        {
          "properties": {
            "host_operation": {
              "const": "repository.summary@1.0.0"
            },
            "resource_scopes": {
              "prefixItems": [
                {
                  "const": "repository:."
                }
              ]
            }
          }
        }
      ]
    },
    "rustCargoSummaryCapability": {
      "allOf": [
        {
          "$ref": "#/$defs/capabilityBase"
        },
        {
          "properties": {
            "host_operation": {
              "const": "rust.cargo_manifest.summary@1.0.0"
            },
            "resource_scopes": {
              "prefixItems": [
                {
                  "const": "file:Cargo.toml"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
